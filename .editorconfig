root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 100
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_packages_to_use_import_on_demand = unset
ij_kotlin_if_brace_force = always
ij_kotlin_for_brace_force = always
ij_kotlin_while_brace_force = always
ij_kotlin_do_while_brace_force = always
ij_kotlin_keep_simple_blocks_in_one_line = false

[*.{bat,cmd}]
end_of_line = crlf
